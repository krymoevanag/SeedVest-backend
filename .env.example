# Local development can continue using SMTP. Render uses EMAIL_PROVIDER=resend.
EMAIL_PROVIDER=smtp
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Required only when EMAIL_PROVIDER=resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Required only to enable Firebase Cloud Messaging delivery.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
